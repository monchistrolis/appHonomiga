<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/paper"
    app:strokeColor="@color/gold"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvFechaHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/crust" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tvEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/ink_soft" />

        <TextView
            android:id="@+id/tvItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:textColor="@color/rye" />

        <TextView
            android:id="@+id/tvContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/ink_soft" />

        <!-- Fila 1: siempre visible — avisar "pan listo" por WhatsApp o por correo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnPanListoWhatsapp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:paddingVertical="8dp"
                android:text="Pan listo (WhatsApp) ✅"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/crumb"
                android:background="@drawable/bg_btn_sage" />

            <Button
                android:id="@+id/btnPanListoCorreo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:paddingVertical="8dp"
                android:text="Pan listo (correo) ✉️"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/crust"
                android:background="@drawable/bg_btn_gold" />

        </LinearLayout>

        <!-- Fila 2: solo despacho -->
        <Button
            android:id="@+id/btnEnCamino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:text="Vamos en camino 🚴"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/crumb"
            android:background="@drawable/bg_btn_rye" />

        <!-- Fila 3: marcar el pedido como completado y sacarlo de la lista principal -->
        <Button
            android:id="@+id/btnMarcarCompletado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:text="✔ Marcar completado"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/crumb"
            android:background="@drawable/bg_btn_crust" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>